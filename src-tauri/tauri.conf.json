{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kerf",
  "version": "0.1.0",
  "identifier": "app.kerf.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kerf",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#0E0E10",
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": [], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Video",
    "fileAssociations": [
      {
        "ext": ["kerf"],
        "name": "Kerf-Projekt",
        "description": "Kerf-Projekt",
        "role": "Editor",
        "mimeType": "application/x-kerf-project"
      }
    ],
    "shortDescription": "Professional video editor"
  }
}
